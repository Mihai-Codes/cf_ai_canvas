{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cf-ai-canvas",
  "main": "src/server.ts",
  "compatibility_date": "2026-05-06",
  "compatibility_flags": ["nodejs_compat"],

  // Static assets — frontend served from Vite build output
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS"
  },

  // Durable Object bindings for agents
  "durable_objects": {
    "bindings": [
      {
        "name": "ChatAgent",
        "class_name": "ChatAgent"
      },
      {
        "name": "CanvasMCP",
        "class_name": "CanvasMCP"
      }
    ]
  },

  // Enable SQLite storage for both agent classes
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ChatAgent", "CanvasMCP"]
    }
  ],

  // Workers AI binding — no API key needed
  "ai": {
    "binding": "AI"
  },

  // KV for persistent canvas snapshots
  "kv_namespaces": [
    {
      "binding": "CANVAS_KV",
      "id": "1881537e70e54a219987bbab132d3543"
    }
  ],

  // Observability
  "observability": {
    "enabled": true
  }
}
